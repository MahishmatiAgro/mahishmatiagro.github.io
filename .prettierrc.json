{
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "htmlWhitespaceSensitivity": "css",
    "proseWrap": "preserve",
    "overrides": [
        {
            "files": ["*.md", "*.yml", "*.yaml"],
            "options": { "tabWidth": 2 }
        }
    ]
}
